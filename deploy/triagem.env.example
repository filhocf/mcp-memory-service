# Instância de triagem — overrides carregados DEPOIS do env base, porque
# EnvironmentFile tem precedência sobre Environment= no systemd.
MCP_MEMORY_SQLITE_PATH=/home/claudio/local-data/mcp/bench/triagem-upstream.db
MCP_EMBEDDING_MODEL=all-MiniLM-L6-v2
MCP_SSE_PORT=3205
MCP_HTTP_PORT=3205
MCP_MEMORY_INCLUDE_HOSTNAME=false
